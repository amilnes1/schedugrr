{
  "name": "schedugrr",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "A local-first task board and calendar with a little growl when work gets done.",
  "author": "Alec Milnes",
  "license": "MIT",
  "homepage": "https://github.com/amilnes1/schedugrr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amilnes1/schedugrr.git"
  },
  "bugs": {
    "url": "https://github.com/amilnes1/schedugrr/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "desktop": "npm run build && tauri dev",
    "desktop:pack": "tauri build --no-bundle",
    "desktop:pack:win": "tauri build --target x86_64-pc-windows-msvc --no-bundle",
    "desktop:dist": "node scripts/package-desktop.mjs",
    "desktop:dist:win": "node scripts/package-desktop.mjs --win",
    "desktop:dist:universal": "node scripts/package-desktop.mjs --universal",
    "typecheck": "tsc -b --noEmit",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run",
    "test:api": "node scripts/test-api.mjs",
    "test:desktop": "node tests/e2e/tauri-qa.mjs",
    "test:watch": "vitest",
    "tauri": "tauri",
    "test:tauri:api": "node scripts/test-tauri-api.mjs",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:windows": "node tests/e2e/tauri-windows-qa.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.462.0",
    "nanoid": "^5.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
